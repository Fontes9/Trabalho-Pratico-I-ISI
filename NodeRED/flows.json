    {
        "id": "3c708855906fcb3a",
        "type": "function",
        "z": "892c4c03051c31fd",
        "name": "formatar venda",
        "func": "let s = msg.payload;\nif (typeof s === 'string') {\n    try { s = JSON.parse(s); } catch (e) { s = {}; }\n}\nif (!s || typeof s !== 'object') { s = {}; }\nconst agora = new Date().toLocaleTimeString('pt-PT');\nconst linha = {\n    hora: agora,\n    id_venda: s.id_venda || '-',\n    produto: s.nome_prod || s.id_produto || '-',\n    quantidade: (s.quantidade !== undefined ? s.quantidade : '-'),\n    total_linha: Number(s.total_linha || 0)\n};\nconst ultimas = flow.get('ultimasVendas') || [];\nultimas.unshift(linha);\nif (ultimas.length > 8) { ultimas.pop(); }\nflow.set('ultimasVendas', ultimas);\nmsg.payload = ultimas;\nreturn msg;",
        "outputs": 1,
        "x": 300,
        "y": 260,
        "wires": [
            [
                "e803798436810417"
            ]
        ]
    },
    {
        "id": "2e94d77dbf48c4bc",
        "type": "function",
        "z": "892c4c03051c31fd",
        "name": "resumo ETL",
        "func": "const s = msg.payload || {};\nconst total = Number(s.total || 0);\nconst n = Number(s.n || 0);\nconst ticket = Number(s.ticket || 0);\nconst linhas = s.linhas || [];\nconst texto = linhas.map(l => l.cidade + ' ' + l.total.toFixed(2)).join(' | ');\nnode.send([\n    { payload: total },\n    { payload: n },\n    { payload: ticket.toFixed(2) },\n    { payload: linhas },\n    { payload: s.timestamp || new Date().toLocaleString('pt-PT') },\n    { payload: texto }\n]);\nreturn null;",
        "outputs": 6,
        "x": 910,
        "y": 380,
        "wires": [
            [
                "7e9e0d6108b14ca8"
            ],
            [
                "d87bca4b465ea9c3"
            ],
            [
                "47086548a3051dda"
            ],
            [
                "db4ca208ba9dd7d6"
            ],
            [
                "4ecfe4b6b31dcf4c"
            ],
            [
                "9ab8999a06758dbf"
            ]
        ]
    },
    {
        "id": "ddaf07be774623b3",
        "type": "function",
        "z": "892c4c03051c31fd",
        "name": "dados ticket",
        "func": "const s = msg.payload || {};\n(s.linhas || []).forEach(l => node.send({ topic: l.cidade, payload: l.ticket }));\nreturn null;",
        "outputs": 1,
        "x": 910,
        "y": 520,
        "wires": [
            [
                "f9b1b47d53847826"
            ]
        ]
    },
    {
        "id": "3bca836b94929aef",
        "type": "function",
