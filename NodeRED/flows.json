    {
        "id": "8e34b8df85349f5d",
        "type": "function",
        "z": "892c4c03051c31fd",
        "name": "parse vendas",
        "func": "const s = msg.payload || {};\nif (msg.error) { node.error(msg.error); return null; }\nconst texto = String(s).trim();\nif (!texto) { node.error('vendas_limpas.csv vazio'); return null; }\nconst linhasFicheiro = texto.split(/\\r?\\n/);\nconst cabecalho = linhasFicheiro.shift().split(';').map(c => c.trim());\nconst registos = linhasFicheiro.filter(l => l.trim()).map(linha => {\n    const campos = linha.split(';');\n    const r = {};\n    cabecalho.forEach((c, i) => { r[c] = (campos[i] || '').trim(); });\n    return r;\n});\nif (!registos.length) { node.error('vendas_limpas.csv sem registos'); return null; }\nlet total = 0;\nconst cidades = {};\nconst produtos = {};\nregistos.forEach(r => {\n    const valor = Number(r.total_linha) || 0;\n    const qtd = Number(r.quantidade) || 0;\n    const cidade = r.cidade_cliente || 'Sem cliente';\n    const produto = r.nome_prod || r.id_produto || 'Desconhecido';\n    total += valor;\n    if (!cidades[cidade]) { cidades[cidade] = { cidade, vendas: 0, total: 0, unidades: 0 }; }\n    cidades[cidade].vendas += 1;\n    cidades[cidade].total += valor;\n    cidades[cidade].unidades += qtd;\n    if (!produtos[produto]) { produtos[produto] = { nome: produto, total: 0, unidades: 0 }; }\n    produtos[produto].total += valor;\n    produtos[produto].unidades += qtd;\n});\nconst n = registos.length;\nconst ticket = n ? total / n : 0;\nconst linhas = Object.values(cidades).map(c => ({\n    cidade: c.cidade,\n    vendas: c.vendas,\n    total: Number(c.total.toFixed(2)),\n    ticket: Number((c.total / c.vendas).toFixed(2)),\n    quota: total ? ((c.total / total) * 100).toFixed(1) + '%' : '0.0%',\n    unidades: c.unidades\n})).sort((a, b) => b.total - a.total);\nconst top = Object.values(produtos).map(p => ({ nome: p.nome, total: Number(p.total.toFixed(2)), unidades: p.unidades })).sort((a, b) => b.total - a.total).slice(0, 5);\nconst max = top.length ? top[0].total : 1;\ntop.forEach(p => { p.pct = max ? Number(((p.total / max) * 100).toFixed(1)) : 0; });\nflow.set('vendasReais', registos);\nconst resumo = { total: Number(total.toFixed(2)), n, ticket: Number(ticket.toFixed(2)), linhas, top, timestamp: new Date().toLocaleString('pt-PT') };\nnode.send([{ payload: resumo }, { payload: resumo }, { payload: resumo }, { payload: resumo }]);\nreturn null;",
