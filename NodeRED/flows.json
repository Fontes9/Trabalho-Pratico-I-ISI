    {
        "id": "71f5e5077ed82e19",
        "type": "function",
        "z": "892c4c03051c31fd",
        "name": "vendas",
        "func": "const vendas = flow.get('vendasReais') || [];\nif (!vendas.length) { node.warn('Sem vendas carregadas de vendas_limpas.csv'); return null; }\nconst i = (flow.get('vendaIdx') || 0) % vendas.length;\nflow.set('vendaIdx', i + 1);\nconst r = vendas[i];\nmsg.topic = 'isi/vendas';\nmsg.payload = {\n    id_venda: r.id_venda,\n    id_produto: r.id_produto,\n    nome_prod: r.nome_prod || '',\n    quantidade: Number(r.quantidade) || 0,\n    preco_unit: Number(r.preco_unit) || 0,\n    total_linha: Number(r.total_linha) || 0\n};\nreturn msg;",
        "outputs": 1,
        "x": 300,
        "y": 80,
        "wires": [
            [
                "f97b5254d4347a90",
                "801c5548b54bb256"
